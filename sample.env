# See https://create-react-app.dev/docs/adding-custom-environment-variables/
# for information on defining new variables

# In most instances, this does not need to be set. Set this if you plan on
# hosting with a CDN at a different path from your homepage in package.json
# By default, PUBLIC_URL is set to the path specified as your homepage. If you
# host at a subpath, you will still need to prefix PUBLIC_URL to static assets.
# PUBLIC_URL=www.[CDN].com/personal_website

# Google analytics ID
# REACT_APP_GA_TRACKING_ID=UA_XXXXXX

# GitHub Discussions comments for blog posts via giscus
# These are optional overrides. The site now defaults to the live repo config.
# REACT_APP_GISCUS_REPO=PiyushDatta/personal_website
# REACT_APP_GISCUS_REPO_ID=R_kgDODprAHw
# REACT_APP_GISCUS_CATEGORY=Announcements
# REACT_APP_GISCUS_CATEGORY_ID=DIC_kwDODprAH84C5DWg
# REACT_APP_GISCUS_THEME=light
# REACT_APP_GISCUS_LANG=en

# Set to `production` to enable analytics and create production optimized builds
NODE_ENV=development
#NODE_ENV=production
